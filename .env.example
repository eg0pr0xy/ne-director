DIRECTOR_DATABASE_URL=postgres://ne_director:ne_director_local_only@127.0.0.1:55434/ne_director
# Disposable ingress-proof database only. `ingress:proof` refuses to run without
# this `_proof` target and never falls back to DIRECTOR_DATABASE_URL.
DIRECTOR_PROOF_DATABASE_URL=postgres://ne_director:ne_director_local_only@127.0.0.1:55435/ne_director_proof
# Google Provider 001 stores callback refresh tokens in the local Windows
# DPAPI SecretStore. These environment names bootstrap only the OAuth client;
# DIRECTOR_GOOGLE_REFRESH_TOKEN remains a read-only local acceptance fallback.
# Never put values in this file:
# DIRECTOR_GOOGLE_OAUTH_CLIENT_ID, DIRECTOR_GOOGLE_OAUTH_CLIENT_SECRET,
# DIRECTOR_GOOGLE_OAUTH_REDIRECT_URI, and DIRECTOR_GOOGLE_REFRESH_TOKEN.
# Do not add real mail or calendar credentials here; inject them only through
# the approved local secret authority.
DIRECTOR_PORT=4600
VITE_DIRECTOR_RUNTIME_MODE=api
VITE_DIRECTOR_API_BASE_URL=http://127.0.0.1:4600/api/v1
